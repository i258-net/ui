{
  "name": "@i258/ui",
  "version": "0.5.0",
  "description": "i258 Design System — shared UI primitives for i258 apps",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i258-net/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/i258-net/ui#readme",
  "bugs": {
    "url": "https://github.com/i258-net/ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js"
    },
    "./input": {
      "types": "./dist/components/input.d.ts",
      "import": "./dist/components/input.js"
    },
    "./textarea": {
      "types": "./dist/components/textarea.d.ts",
      "import": "./dist/components/textarea.js"
    },
    "./label": {
      "types": "./dist/components/label.d.ts",
      "import": "./dist/components/label.js"
    },
    "./form-field": {
      "types": "./dist/components/form-field.d.ts",
      "import": "./dist/components/form-field.js"
    },
    "./link": {
      "types": "./dist/components/link.d.ts",
      "import": "./dist/components/link.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox.d.ts",
      "import": "./dist/components/checkbox.js"
    },
    "./badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js"
    },
    "./surface": {
      "types": "./dist/components/surface.d.ts",
      "import": "./dist/components/surface.js"
    },
    "./alert": {
      "types": "./dist/components/alert.d.ts",
      "import": "./dist/components/alert.js"
    },
    "./toggle-chip": {
      "types": "./dist/components/toggle-chip.d.ts",
      "import": "./dist/components/toggle-chip.js"
    },
    "./disclosure": {
      "types": "./dist/components/disclosure.d.ts",
      "import": "./dist/components/disclosure.js"
    },
    "./choice": {
      "types": "./dist/components/choice.d.ts",
      "import": "./dist/components/choice.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && pnpm build:css",
    "build:css": "node ./scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ./scripts/lint-deferred.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.12",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
