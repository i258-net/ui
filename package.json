{
  "name": "i258-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @i258/ui build",
    "typecheck": "pnpm -r typecheck",
