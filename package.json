{
  "name": "i258-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @i258/ui build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "pnpm -r test",
    "workshop": "pnpm --filter @i258/workshop storybook",
    "workshop:build": "pnpm --filter @i258/workshop build-storybook",
    "vrt": "pnpm workshop:build && pnpm --filter @i258/workshop vrt",
    "vrt:update": "pnpm workshop:build && pnpm --filter @i258/workshop vrt:update"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "7.0.2"
  }
}
